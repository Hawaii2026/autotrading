# Copy to .env and fill in. .env is gitignored — it is the only secret in the
# system. NEVER paste the webhook into source code, logs, dashboards, or commits.

# --- Discord (the alert channel) ---
# Discord server -> channel -> Edit Channel -> Integrations -> Webhooks ->
# New Webhook -> Copy Webhook URL. Enable mobile push notifications for that
# channel in the Discord app so alerts buzz your phone.
DISCORD_WEBHOOK_URL=

# Alert channel selector (leave as discord)
ALERT_CHANNEL=discord

# --- KarenBridge feed (read-only market-data capture; see docs/decisions.md) ---
# GET endpoint of the Karen deployment's market-data bridge. Display-grade
# (2 Hz sampled) — used by research/lib/tick_recorder.py for the dashboard
# live strip and feed monitoring, NEVER for backtest data.
KAREN_FEED_URL=https://karen-intelligence.fly.dev/api/karen/ninjatrader/market-data
