# Copy to .env and fill in. .env is gitignored — it is the only secret in the system.

# --- Telegram (recommended: simplest phone push) ---
# Create a bot with @BotFather, then message your bot once and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord (alternative: a channel webhook URL) ---
DISCORD_WEBHOOK_URL=

# Which channel the alert sender uses: "telegram" or "discord"
ALERT_CHANNEL=telegram

# --- KarenBridge feed (read-only market-data capture; see docs/decisions.md) ---
# GET endpoint of the Karen deployment's market-data bridge. Display-grade
# (2 Hz sampled) — used by research/lib/tick_recorder.py for the dashboard
# live strip and feed monitoring, NEVER for backtest data.
KAREN_FEED_URL=https://karen-intelligence.fly.dev/api/karen/ninjatrader/market-data
